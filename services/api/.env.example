# Application
APP_ENV=development
APP_LOG_LEVEL=INFO

# Database (PostgreSQL)
# DATABASE_URL takes precedence; DB_URL is the documented repo convention
DATABASE_URL=postgresql+asyncpg://research:change-me-strong-password@localhost:5433/eth_platform
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Delta Exchange (REST)
# Public endpoints work without credentials; set BOTH keys for authenticated
# requests. Never commit real secrets (see configs/README.md).
# DELTA_BASE_URL=https://api.india.delta.exchange
# DELTA_API_KEY=
# DELTA_API_SECRET=
# DELTA_REQUEST_TIMEOUT=10

# FRED (Federal Reserve Economic Data) — required for app/connectors/fred.py.
# Free, but requires a registered API key: https://fred.stlouisfed.org/docs/api/api_key.html
# Never commit a real key (see configs/README.md).
# FRED_API_KEY=
# FRED_BASE_URL=https://api.stlouisfed.org
# FRED_REQUEST_TIMEOUT=10

# Etherscan — required for app/connectors/etherscan.py.
# Free, but requires a registered API key: https://etherscan.io/apidashboard
# Never commit a real key (see configs/README.md).
# ETHERSCAN_API_KEY=
# ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
# ETHERSCAN_CHAIN_ID=1
# ETHERSCAN_REQUEST_TIMEOUT=10

# DefiLlama — required for app/connectors/defillama.py.
# Free, unauthenticated — no API key needed (confirmed live, see that
# module's own docstring). Uncomment only to override a default.
# DEFILLAMA_BASE_URL=https://api.llama.fi
# DEFILLAMA_CHAIN=Ethereum
# DEFILLAMA_REQUEST_TIMEOUT=10

# CoinGecko — used by app/connectors/coingecko.py.
# Genuinely optional, not just "not configured yet": /global works fully
# keyless (confirmed live). A free Demo key (https://www.coingecko.com/en/api/pricing)
# only raises the rate limit to a documented 100 calls/min.
# Never commit a real key (see configs/README.md).
# COINGECKO_API_KEY=
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# COINGECKO_REQUEST_TIMEOUT=10

# Marketaux — required for app/connectors/marketaux.py.
# Free, but requires a registered API key: https://www.marketaux.com/account/dashboard
# Never commit a real key (see configs/README.md).
# MARKETAUX_API_KEY=
# MARKETAUX_BASE_URL=https://api.marketaux.com/v1
# MARKETAUX_SYMBOLS=ETHUSD
# MARKETAUX_REQUEST_TIMEOUT=10
# MARKETAUX_ARTICLES_PER_PAGE=3
# MARKETAUX_MAX_PAGES_PER_FETCH=10

# News sync — app.services.news_sync.NewsSyncScheduler (separate from the
# generic ExternalDataSyncScheduler; see ConnectorMetadata.auto_synced).
# NEWS_SYNC_ENABLED=true
# NEWS_SYNC_INTERVAL_SECONDS=21600
# NEWS_SYNC_BACKFILL_DAYS=3650

# Order-flow capture — app.services.order_flow_capture.OrderFlowCapture.
# Persists streamed trades + periodic reconstructed order-book snapshots to
# `trade_flow` / `orderbook_snapshots`. A capture mechanism only (no
# backfill, nothing reads the tables yet). Only runs when MARKET_DATA_LIVE
# is also true; unlike every connector this data has NO historical backfill,
# so every day it is off is a day permanently lost. Grows unbounded
# otherwise — measured at ~15-30MB/day combined for two symbols (see
# ARCHITECTURE.md) — so a retention sweep prunes rows past
# ORDERFLOW_RETENTION_DAYS on its own, coarser cadence.
# ORDERFLOW_CAPTURE_ENABLED=true
# ORDERFLOW_SNAPSHOT_INTERVAL_SECONDS=15
# ORDERFLOW_SNAPSHOT_DEPTH=25
# ORDERFLOW_TRADE_FLUSH_SECONDS=5
# ORDERFLOW_TRADE_BUFFER_MAX=500
# ORDERFLOW_RETENTION_DAYS=60
# ORDERFLOW_PRUNE_INTERVAL_SECONDS=3600
