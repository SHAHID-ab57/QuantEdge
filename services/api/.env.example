# Application
APP_ENV=development
APP_LOG_LEVEL=INFO

# Database (PostgreSQL)
# DATABASE_URL takes precedence; DB_URL is the documented repo convention
DATABASE_URL=postgresql+asyncpg://research:change-me-strong-password@localhost:5433/eth_platform
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Delta Exchange (REST)
# Public endpoints work without credentials; set BOTH keys for authenticated
# requests. Never commit real secrets (see configs/README.md).
# DELTA_BASE_URL=https://api.india.delta.exchange
# DELTA_API_KEY=
# DELTA_API_SECRET=
# DELTA_REQUEST_TIMEOUT=10

# FRED (Federal Reserve Economic Data) — required for app/connectors/fred.py.
# Free, but requires a registered API key: https://fred.stlouisfed.org/docs/api/api_key.html
# Never commit a real key (see configs/README.md).
# FRED_API_KEY=
# FRED_BASE_URL=https://api.stlouisfed.org
# FRED_REQUEST_TIMEOUT=10
