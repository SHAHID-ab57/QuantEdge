# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.db

# Locally-serialized baseline model artifacts (app/training/serialization.py) —
# anchored to this directory only, matching the root .gitignore's own
# ML-artifact-directory convention, so it can never shadow a real source
# directory named `var` nested somewhere else in the tree.
/var/

# Environment
.env
.env.*
!.env.example

# The repo root's `/models/` rule is anchored to the repo root only (it
# targets a hypothetical top-level ML-artifact scratch directory, never
# committed) and therefore cannot match this nested `app/models/` — the
# ORM models package. The negation below is defense-in-depth only, kept
# in case a future edit widens the root rule back to a bare, unanchored
# `models/`; it is not required for `app/models/` to be tracked today.
!app/models/
!app/models/**
app/models/__pycache__/