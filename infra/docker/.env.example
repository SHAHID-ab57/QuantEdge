# ============================================================
# Docker Compose Environment Example
# ============================================================
# Copy this file to .env beside docker-compose.yml and fill
# in values. Never commit the real .env file.
#
#   cp infra/docker/.env.example infra/docker/.env
#
# Values shown are placeholders; generate your own passwords.

# --- PostgreSQL ---
POSTGRES_USER=research
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=eth_platform
# Host port exposed for local connections (default 5432)
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=change-me-strong-password
# Host port exposed for local connections (default 6379)
REDIS_PORT=6379

# --- Future application services (unused until enabled) ---
# WEB_PORT=3000
# API_PORT=8000