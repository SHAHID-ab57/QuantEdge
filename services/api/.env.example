# services/api/.env.example
#
# Every variable here is read by a real, typed field in app/core/config.py
# (pydantic_settings.BaseSettings) — this file was regenerated directly
# from that file, field by field (106 fields, confirmed:
# `grep -cE '^    [a-z_][a-z0-9_]*: ' app/core/config.py`), not hand-typed
# from memory. Env var name = the field name, uppercased, no prefix.
#
# Commented-out lines show the field's real code-level default — copy
# to .env and uncomment only what you need to change. Uncommented lines
# are fields with no safe default (secrets, connection strings, or a
# deliberately-empty "not configured" placeholder) that a real deployer
# must decide about.
#
# NEVER commit a real .env — see .gitignore. See STATE.md §4 for the
# full audit that found the previous version of this file covered 6 of
# these 106 fields.

# ============================================================
# Application
# ============================================================
# APP_NAME=eth-ai-api
# APP_VERSION=0.1.0
# development | test | staging | production
# APP_ENV=development
# NOT APP_LOG_LEVEL — the field is `log_level` (app/core/config.py:28),
# so the real env var is LOG_LEVEL with no APP_ prefix. Confirmed live:
# the existing dev .env has been setting APP_LOG_LEVEL this whole time,
# which pydantic-settings silently ignores (`extra="ignore"`) — it has
# never actually changed the log level, just happened to match the
# "INFO" default. See STATE.md flagged issue #4's resolution.
# LOG_LEVEL=INFO
# Comma-separated is NOT how this one parses — it's a real JSON/py list
# field; pydantic-settings reads a JSON array from the env var for
# list-typed fields. Only set this if the default (localhost:3000 +
# 127.0.0.1:3000) doesn't cover your dashboard's real origin.
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ============================================================
# Database (PostgreSQL, async — asyncpg driver)
# ============================================================
# Required — no default, and every DB-backed route/startup check fails
# without it. `DB_URL` also works (accepted as an alias of this same
# field). Local Docker Postgres (see infra/docker/): user/db default to
# research/eth_platform; port depends on infra/docker/.env's
# POSTGRES_PORT (5433 in this repo's own dev setup, not Postgres's
# default 5432 — see STATE.md §3).
DATABASE_URL=postgresql+asyncpg://research:CHANGE_ME@localhost:5433/eth_platform
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_ECHO=false

# ============================================================
# Redis (M5-E3-T1) — rate limiting, login lockout, token revocation
# ============================================================
# Genuinely optional — blank/unset means every one of those three
# features runs its in-process fallback instead (see ARCHITECTURE.md
# § "Redis"). If you DO set this, it must be reachable at startup or
# the app hard-fails (same "configured-but-broken fails loudly"
# contract as DATABASE_URL) — see STATE.md's flagged issue #1 for a
# real example of this pointing at the wrong Redis.
REDIS_URL=

# ============================================================
# Pagination & per-list limits (all have safe defaults; rarely need changing)
# ============================================================
# CANDLES_DEFAULT_LIMIT=100
# CANDLES_MAX_LIMIT=1000
# EXPERIMENTS_DEFAULT_LIMIT=50
# EXPERIMENTS_MAX_LIMIT=200
# TRAINING_JOBS_DEFAULT_LIMIT=50
# TRAINING_JOBS_MAX_LIMIT=200
# ML_DATASET_BUILDS_DEFAULT_LIMIT=20
# ML_DATASET_BUILDS_MAX_LIMIT=100
# How many completed training jobs one benchmark comparison may fetch at once.
# EVALUATION_BENCHMARK_MAX_CANDIDATES=100
# EVALUATION_HISTORY_DEFAULT_LIMIT=20
# EVALUATION_HISTORY_MAX_LIMIT=100
# PREDICTIONS_DEFAULT_LIMIT=20
# PREDICTIONS_MAX_LIMIT=100
# BACKTESTS_DEFAULT_LIMIT=20
# BACKTESTS_MAX_LIMIT=100
# Largest number of steps a single backtest will ever walk in one run.
# MAX_BACKTEST_STEPS=2000
# Where fitted baseline model artifacts (.joblib) are written — relative
# to the service's working directory unless given as an absolute path.
# 1.9GB of these exist in dev and are gitignored — see STATE.md §6/§9.
# MODEL_ARTIFACT_DIR=var/model_artifacts

# ============================================================
# Delta Exchange (market data + trading venue integration)
# ============================================================
# DELTA_BASE_URL=https://api.india.delta.exchange
# Required only for authenticated/private REST or WS calls — public
# market data (candles, the public WS feed) works without these. Get
# from your Delta Exchange India account's API settings.
DELTA_API_KEY=
DELTA_API_SECRET=
# DELTA_REQUEST_TIMEOUT=10.0
# DELTA_WS_URL=wss://public-socket.india.delta.exchange
# DELTA_WS_PRIVATE_URL=wss://socket.india.delta.exchange
# DELTA_WS_RECONNECT_DELAY=2.0
# DELTA_WS_MAX_RETRIES=0
# Whether the live Delta WebSocket feed (trades/ticker/order book) runs
# at all — off by default; the app still serves REST-ingested candle
# history without this. STATE.md's docker-compose.yml sets this to
# `true` for the containerized stack specifically because it was asked
# to run with the live feed on.
# MARKET_DATA_LIVE=false
# DELTA_MARKET_SYMBOLS=BTCUSD,ETHUSD

# ============================================================
# Order-flow / microstructure capture (only runs if MARKET_DATA_LIVE=true)
# ============================================================
# ORDERFLOW_CAPTURE_ENABLED=true
# ORDERFLOW_SNAPSHOT_INTERVAL_SECONDS=15
# ORDERFLOW_SNAPSHOT_DEPTH=25
# ORDERFLOW_TRADE_FLUSH_SECONDS=5
# ORDERFLOW_TRADE_BUFFER_MAX=500
# ORDERFLOW_RETENTION_DAYS=60
# ORDERFLOW_PRUNE_INTERVAL_SECONDS=3600

# ============================================================
# Authentication (JWT)
# ============================================================
# REQUIRED — no default. Unlike DELTA_*/connector keys (which degrade
# gracefully when unset), an unset JWT secret fails the WHOLE
# application at startup, on purpose (ARCHITECTURE.md § "Authentication
# & Audit Trail" → "JWT secret startup enforcement"). Generate a real
# random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================
# Rate limiting & login lockout (M5-E2-T1 / M5-E3-T1)
# ============================================================
# General inbound rate limiting — not a brute-force defense, see
# LOGIN_LOCKOUT_* below for that.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60
# Dedicated brute-force / credential-stuffing defense on POST /auth/login.
# LOGIN_LOCKOUT_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_WINDOW_SECONDS=300
# LOGIN_LOCKOUT_COOLDOWN_SECONDS=900

# ============================================================
# Candle sync & prediction grading (in-process scheduled loops)
# ============================================================
# CANDLE_SYNC_ENABLED=true
# CANDLE_SYNC_INTERVAL_SECONDS=300
# CANDLE_SYNC_TIMEFRAMES=1m,5m,15m,30m,1h,4h,1d
# Empty means "resolve a sensible default" (mirrors DELTA_MARKET_SYMBOLS).
# CANDLE_SYNC_SYMBOLS=
# CANDLE_SYNC_BACKFILL_DAYS=7
# PREDICTION_GRADING_ENABLED=true
# PREDICTION_GRADING_INTERVAL_SECONDS=300

# ============================================================
# Paper Trading
# ============================================================
# Fixed-basis-point execution model — never zero by default (an
# unrealistically generous simulation is worse than none).
# PAPER_TRADING_SLIPPAGE_BPS=5
# PAPER_TRADING_FEE_BPS=10
# A triggered stop-loss/take-profit close uses a wider slippage allowance.
# PAPER_TRADING_TRIGGERED_SLIPPAGE_BPS=25
# How old a resolved price quote can be before a fill is flagged stale.
# PAPER_TRADING_STALE_PRICE_THRESHOLD_SECONDS=300
# PAPER_TRADING_ACCOUNTS_DEFAULT_LIMIT=20
# PAPER_TRADING_ACCOUNTS_MAX_LIMIT=100
# PAPER_TRADING_ORDERS_DEFAULT_LIMIT=20
# PAPER_TRADING_ORDERS_MAX_LIMIT=100
# Pre-trade risk limits applied to a new account unless it overrides them
# (percentages, e.g. 10 means 10%).
# PAPER_TRADING_DEFAULT_MAX_POSITION_SIZE_PCT=10
# PAPER_TRADING_DEFAULT_MAX_EXPOSURE_PCT=50
# PAPER_TRADING_DEFAULT_MAX_DRAWDOWN_PCT=20
# Bounded retries for the optimistic-concurrency guard around placing an order.
# PAPER_TRADING_MAX_ORDER_ATTEMPTS=5
# Gates whether the automated-strategy loop runs at all; each account's
# own strategy_enabled (default false, per-account, DB-stored — see
# STATE.md flagged issue #7) is the real per-account opt-in on top of this.
# PAPER_TRADING_STRATEGY_SCHEDULER_ENABLED=true
# PAPER_TRADING_STRATEGY_INTERVAL_SECONDS=300
# PAPER_TRADING_STRATEGY_DEFAULT_CONFIDENCE_THRESHOLD_PCT=65
# PAPER_TRADING_STRATEGY_DEFAULT_STOP_LOSS_PCT=5
# PAPER_TRADING_STRATEGY_DECISIONS_DEFAULT_LIMIT=20
# PAPER_TRADING_STRATEGY_DECISIONS_MAX_LIMIT=100

# ============================================================
# External data connectors
# ============================================================
# --- Alternative.me Fear & Greed Index — free, no key required ---
# FEAR_GREED_BASE_URL=https://api.alternative.me
# FEAR_GREED_REQUEST_TIMEOUT=10.0

# --- FRED (St. Louis Fed) — requires a free API key ---
# Get one at https://fred.stlouisfed.org/docs/api/api_key.html
# Blank is a valid "not configured yet" state: the connector still
# registers, and only fails at fetch time if actually called.
FRED_API_KEY=
# FRED_BASE_URL=https://api.stlouisfed.org
# FRED_REQUEST_TIMEOUT=10.0

# --- Etherscan V2 API — requires a free API key ---
# Get one at https://etherscan.io/apis
ETHERSCAN_API_KEY=
# ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
# 1 = Ethereum mainnet; V2 folds every EVM chain behind one base URL,
# distinguished by this query parameter.
# ETHERSCAN_CHAIN_ID=1
# ETHERSCAN_REQUEST_TIMEOUT=10.0

# --- DefiLlama — free, no key required ---
# DEFILLAMA_BASE_URL=https://api.llama.fi
# DEFILLAMA_CHAIN=Ethereum
# DEFILLAMA_REQUEST_TIMEOUT=10.0

# --- CoinGecko — genuinely optional key ---
# /global works fully keyless; a Demo key only raises the rate limit
# (100 calls/min). Get one at https://www.coingecko.com/en/developers/dashboard
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
# COINGECKO_REQUEST_TIMEOUT=10.0

# --- Marketaux news — requires a free API key ---
# Get one at https://www.marketaux.com/account/dashboard
# Hard-required, unlike CoinGecko above: an unauthenticated request
# returns a real HTTP 401 (confirmed live, not assumed).
MARKETAUX_API_KEY=
# MARKETAUX_BASE_URL=https://api.marketaux.com/v1
# Marketaux's own entity-symbol convention; ETHUSD needs no translation.
# MARKETAUX_SYMBOLS=ETHUSD
# MARKETAUX_REQUEST_TIMEOUT=10.0
# Free plan's real documented cap — raise only if a paid plan is in use.
# MARKETAUX_ARTICLES_PER_PAGE=3
# Bounds how many of the free tier's 100 requests/day one fetch() may spend paginating.
# MARKETAUX_MAX_PAGES_PER_FETCH=10

# ============================================================
# News sync (dedicated scheduler for Marketaux — see marketaux_* above)
# ============================================================
# NEWS_SYNC_ENABLED=true
# 21600 = 6 hours (4 ticks/day, sized to the free tier's request budget).
# NEWS_SYNC_INTERVAL_SECONDS=21600
# Window seeded for a first-ever sync with nothing stored yet.
# NEWS_SYNC_BACKFILL_DAYS=3650

# ============================================================
# External data sync (generic scheduler for Fear & Greed / FRED /
# Etherscan / DefiLlama / CoinGecko — everything except Marketaux news,
# which has its own scheduler above)
# ============================================================
# EXTERNAL_DATA_SYNC_ENABLED=true
# 3600 = hourly; these sources update far less often than that, so
# there's nothing new to fetch more frequently.
# EXTERNAL_DATA_SYNC_INTERVAL_SECONDS=3600
# Comma-separated connector source names to keep synced; every
# registered connector when empty.
# EXTERNAL_DATA_SYNC_SOURCES=
# Window seeded for a source with no stored data points yet.
# EXTERNAL_DATA_SYNC_BACKFILL_DAYS=3650
